<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 音乐进度应用选择器需要枚举所有可启动应用 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- 快递取件码：只读未读收件箱，判断"这条码确实在短信里" -->
    <uses-permission android:name="android.permission.READ_SMS" />

    <application
        android:name=".TapDockApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TapDock">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DownloadPickerActivity"
            android:exported="false"
            android:label="@string/download_pick_title" />

        <activity
            android:name=".CardOrderActivity"
            android:exported="false"
            android:label="@string/card_order_title" />

        <!-- Hook 侧轮询读取配置的入口（即使广播丢失/XSharedPreferences 失效也生效） -->
        <provider
            android:name=".DockConfigProvider"
            android:authorities="com.lsp102.tapdock.config"
            android:exported="true" />

        <!-- 面板请求游戏信息时由 SystemUI 唤醒，跑一次 root 采集就退 -->
        <receiver
            android:name=".GameQueryReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.lsp102.tapdock.GAME_QUERY" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".SysStatQueryReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.lsp102.tapdock.SYSSTAT_QUERY" />
            </intent-filter>
        </receiver>

        <!-- 小窗卡片要窗口画面时由 SystemUI 唤醒，跑一次 root 截屏 + 裁剪就退 -->
        <receiver
            android:name=".WindowShotQueryReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.lsp102.tapdock.SHOT_QUERY" />
            </intent-filter>
        </receiver>

        <!-- 取件码显示的手动测试台：am broadcast 注入一条"取件短信"，见 PackageCodeTestReceiver -->
        <receiver
            android:name=".PackageCodeTestReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.lsp102.tapdock.PKGCODE_TEST" />
            </intent-filter>
        </receiver>

        <!-- LSPosed / Xposed 模块声明 -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/xposed_desc" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />
        <meta-data
            android:name="xposedsharedprefs"
            android:value="dock_prefs" />
    </application>
</manifest>
