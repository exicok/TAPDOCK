<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_preview_label"
            style="@style/Text.Desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/preview_dock_title" />

        <!-- 按 Hook 侧回报的真实内容现建，见 MainActivity.bindPreview -->
        <LinearLayout
            android:id="@+id/pill"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_dock_pill"
            android:gravity="center_vertical"
            android:minWidth="120dp"
            android:orientation="horizontal"
            android:paddingStart="7dp"
            android:paddingEnd="7dp" />

        <TextView
            android:id="@+id/tv_preview_hint"
            style="@style/Text.Desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/preview_dock_waiting"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
